<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/EMCL/EMCL.csproj" />
    <None Update="meter.example.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="meter.serial.example.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="meter.local.json" CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('$(MSBuildProjectDirectory)/meter.local.json')" />
  </ItemGroup>
  <Target Name="RemoveMissingLocalMeterConfiguration" AfterTargets="Build"
          Condition="!Exists('$(MSBuildProjectDirectory)/meter.local.json')">
    <Delete Files="$(TargetDir)meter.local.json" />
  </Target>
</Project>
